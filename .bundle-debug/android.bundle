        return {
          full: 'Show all',
          short: 'Show all'
        };
      } else {
        return {
          full: 'Hide extended frames',
          short: 'Hide'
        };
      }
    }
    var short = collapsed ? 'Show' : 'Hide';
    var framePlural = `frame${collapsedCount > 1 ? 's' : ''}`;
    if (collapsedCount === stackFrames.length) {
      return {
        full: `${short}${collapsedCount > 1 ? ' all ' : ' '}${collapsedCount} ignore-listed ${framePlural}`,
        short
      };
    } else {
