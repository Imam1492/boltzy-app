{
  "expo": {
    "name": "boltzy-app",
    "slug": "boltzy-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "boltzy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Boltzy needs access to your camera so you can take photos of items you want to sell.",
        "NSPhotoLibraryUsageDescription": "Boltzy needs access to your photo library to upload images for your listings.",
        "NSLocationWhenInUseUsageDescription": "Boltzy uses your location to show you items for sale nearby.",
        "NSContactsUsageDescription": "Boltzy requires contacts access so you can easily share contact info in chats."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.imam_khan.boltzyapp",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#0F172A" 
          }
        }
      ],
      "expo-localization",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-secure-store",
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "92722222-b5c1-477e-ab75-430b3970710d"
      }
    }
  }
}